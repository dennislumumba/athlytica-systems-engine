# Server-only — never prefix these with NEXT_PUBLIC_, never ship to the client.

# Supabase project URL, e.g. https://qxfrypvevjsyzkquewxh.supabase.co
SUPABASE_URL=

# Supabase service_role key (bypasses RLS). Required so the onboarding RPC
# can write athlete/provenance/cohort_session_registry rows. Keep this out
# of client bundles and out of source control.
SUPABASE_SERVICE_ROLE_KEY=

# Shared HMAC-SHA256 secret. The Google Apps Script webhook must sign its
# JSON body with this same secret and send the hex digest as X-Signature.
GOOGLE_FORMS_WEBHOOK_SECRET=

# Slack incoming webhook URL used by scripts/send_daily_exec_briefing.py.
# Set this in your local environment, never commit the real value.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------
# G-W6-PAY payment gate (register route + mpesa-callback route)
# ---------------------------------------------------------------------

# HMAC-SHA256 key for MSISDN hashing (>= 16 chars). DPA law: raw phone
# numbers are NEVER persisted — unset key seals both payment surfaces (503).
MSISDN_HASH_KEY=

# Shared secret for machine settlement rails (Daraja/NCBA notification
# headers: X-Callback-Secret). Unset = callback surface sealed (403).
MPESA_CALLBACK_SECRET=

# Founder/ops console token (X-Ops-Token) for MANUAL_RECON settlements.
OPS_CONSOLE_TOKEN=

# Optional: fires REGISTRATION_PAYMENT_SETTLED webhooks on matched settlement.
DRAFT_AUTH_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Onboarding email (settlement → parent's onboarding pack)
# ---------------------------------------------------------------------

# Resend API key. Unset = onboarding mail is DISABLED and every settlement
# logs "[onboarding] PACK NOT SENT" for manual follow-up. Payment,
# registration and settlement are unaffected — mail is never a condition
# of any of them.
RESEND_API_KEY=

# Verified sender, e.g. "NRHL <registrations@nairobihockey.com>". The
# domain must be verified with the provider or every send is rejected.
NRHL_MAIL_FROM=

# Daraja (M-Pesa) STK push credentials for Paybill 4325935 (Athlytica
# Technologies Limited). Unset = STK dispatch disabled; registration
# falls back to manual Paybill instructions (fail-soft).
# (Directive alias mapping: MPESA_CONSUMER_KEY -> DARAJA_CONSUMER_KEY,
#  MPESA_CONSUMER_SECRET -> DARAJA_CONSUMER_SECRET,
#  MPESA_PASSKEY -> DARAJA_PASSKEY, MPESA_CALLBACK_URL -> DARAJA_CALLBACK_URL.
#  MPESA_PAYBILL is code-level: config/payment-rail.ts.)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
# Business shortcode for STK; defaults to Paybill 4325935 when unset.
DARAJA_STK_SHORTCODE=
# Public HTTPS URL of /api/v1/biz/mpesa-callback, e.g.
# https://nairobihockey.com/api/v1/biz/mpesa-callback
DARAJA_CALLBACK_URL=
# "production" for live rail; anything else targets the Daraja sandbox.
DARAJA_ENV=

# Founder-set registration fees in KES (whole numbers). Unset fee seals
# registration for that venture (503 CONFIG_DEBT) — no defaults invented.
REG_FEE_NRHL_KES=
REG_FEE_BIG_ICE_KES=
REG_FEE_ATHLYTICA_KES=

# ---------------------------------------------------------------------
# Browser-safe (workspace shell + coach/parent hooks). These ARE shipped
# to the client by design — they are the publishable pair, never the
# service_role key.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
